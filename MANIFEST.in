# sdist scope: ship everything needed to audit, rebuild and re-verify the
# release from the tarball — sources, C kernels, full test suite (including
# the tests/ subdirectories), docs, examples, benchmarks and tooling.
# Deliberately excluded: build outputs and local run artifacts.
#
# package.json, scripts/ and .github/workflows are included because the shipped
# test suite reads them: tests/test_release_metadata.py opens package.json,
# tests/test_workflow_graph.py imports scripts/check_workflows.py, and that
# audit reads .github/workflows. Without them an unpacked sdist fails at
# collection instead of proving the release.
include README.md LICENSE CHANGELOG.md CITATION.cff codemeta.json pyproject.toml setup.py package.json
graft src
graft tests
graft docs
graft examples
graft benchmarks
graft tools
graft packaging
graft scripts
graft .github/workflows
global-exclude *.py[cod]
global-exclude __pycache__/*
global-exclude *.egg-info/*
prune site
prune dist
prune build
prune guided-fit-results
